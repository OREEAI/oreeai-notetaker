ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME=oreeai-notetaker
API_V1_PREFIX=/api/v1

POSTGRES_USER=oreeai
POSTGRES_PASSWORD=oreeai
POSTGRES_DB=oreeai
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgresql+asyncpg://oreeai:oreeai@localhost:5433/oreeai

REDIS_URL=redis://localhost:6380/0
CACHE_ENABLED=true
CACHE_PREFIX=oreeai
CACHE_TTL_SECONDS=300

# Shared secret required as X-API-Key on every /api/v1 route (including
# /health). Generate with `openssl rand -hex 32`; required, no default.
API_KEY=change-me-32-chars-minimum
# Active (non-terminal) call ceiling the service and runner enforce.
CALL_CONCURRENCY_LIMIT=3
# Docker image tag the runner spawns for bots.
BOT_IMAGE_TAG=local
# Compose network bot containers attach to (must reach the webhook/API as needed).
BOT_DOCKER_NETWORK=oreeai_internal
# Host path of the shared audio volume mounted into bot containers.
AUDIO_HOST_PATH=/var/lib/oreeai/audio
# Host path of the persistent Chrome profile (authenticated mode). The runner
# copies it per call to avoid Chrome SingletonLock collisions; set per host,
# e.g. /var/lib/oreeai/chrome-profile. Empty disables the profile mount.
BOT_PROFILE=
# Runner stale-call sweep cutoff (matches the bot's hard recording cap).
BOT_MAX_RECORD_DURATION=10800
# Webhook delivery: per-attempt seconds, attempts, receiver timestamp skew.
WEBHOOK_HTTP_TIMEOUT=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMESTAMP_SKEW=300

# Object storage (PR 6) — S3 API-compatible; the same vars work for AWS,
# Cloudflare R2, Hetzner Object Storage, Backblaze B2, and MinIO
# (provider switch = env change, no code). Leave the bucket unset for
# local dev: the runner falls back to local object storage under
# AUDIO_HOST_PATH. In production the runner refuses to start without it.
# Note: presigned URLs are generated against S3_ENDPOINT_URL with
# path-style + signature v4 (required for R2/B2/MinIO presigning).
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side encryption requested on every upload (S3-managed keys).
S3_SSE=AES256
# TTL (seconds) for presigned GET audio URLs; PR 7's provider fetch uses these.
S3_PRESIGN_TTL_SECONDS=3600
# Retention: done-call audio deleted this long after done (0 = immediately);
# failed-call audio deleted this long after the failure. Transcripts are kept.
AUDIO_RETENTION_DAYS=0
FAILED_AUDIO_RETENTION_DAYS=7

# Transcription (PR 7) — provider settled: Deepgram nova-3, pre-recorded
# batch, diarization via diarize_model=latest (see docs/transcription.md).
# Leave unset for local dev: the runner falls back to the stub provider
# (honest empty transcript, no network) with a loud warning. Production
# refuses to start without a real provider; "stub" is never valid there.
# Valid values: deepgram | stub
TRANSCRIPTION_PROVIDER=
DEEPGRAM_API_KEY=
# Refuse transcription above this many audio bytes (2 GB; matches
# Deepgram's own pre-recorded file-size limit).
AUDIO_MAX_BYTES=2147483648

# Deploy (PR 8) — docker-compose.prod.yml, the VPS stack. See
# deploy/README.md for the end-to-end procedure.
# Tag for the app image built from the repo Dockerfile (api + bot-runner);
# dev keeps `local`, the VPS uses release tags (v0.1.0, v0.1.1, ...).
API_IMAGE_TAG=v0.1.0
# Loopback-only host port the prod api binds (OreeAI's stack shares the
# host; change if 8000 is taken). Never published beyond loopback.
API_HOST_PORT=8000
# GID owning the host docker socket (`stat -c '%g' /var/run/docker.sock`);
# the non-root bot-runner container needs it to drive the socket.
DOCKER_GID=999
# Host path for pg_dump output (bind-mounted into db at /backups).
BACKUPS_HOST_PATH=/var/lib/oreeai/backups
# Nightly backup schedule (documented in deploy/backup.cron) and local
# dump retention in days (0 disables cleanup).
BACKUP_CRON=0 3 * * *
BACKUP_KEEP_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]

# Bot join identity. anonymous = guest join (default code behavior);
# authenticated = signed-in join via the persistent Chrome profile below.
# Production runs use authenticated; anonymous stays for A/B and fallback.
BOT_AUTH_MODE=authenticated
# Container-side profile path. The Makefile mounts the host profile dir here;
# override the host side with BOT_PROFILE=/path/to/chrome-profile.
BOT_PROFILE_DIR=/profile
# Recording-consent gate. The bot exits 6 (consent_missing) without it. The
# runner passes it per call; command-line assignments override this file.
CONSENT_ACK=true
# ENVIRONMENT=production also makes the bot fatal when the signed-in account's
# display name is not the dedicated consent identity (bot/README: Consent).
